---
// Visual data flow diagram showing how data moves through the VetFo platform.
---

<div class="space-y-3 text-xs" style="font-family: var(--font-heading)">
  {/* Data Sources */}
  <div>
    <p class="mb-2 text-xs tracking-widest text-gray-400 uppercase dark:text-gray-500">
      Data Sources
    </p>
    <div class="grid grid-cols-3 gap-2">
      <div
        class="rounded-md border border-gray-200 bg-white px-3 py-2.5 text-center dark:border-gray-700 dark:bg-gray-900"
      >
        <p class="font-medium text-gray-700 dark:text-gray-300">Mobile Apps</p>
        <p class="mt-0.5 text-xs text-gray-400 dark:text-gray-500">iOS · Android</p>
      </div>
      <div
        class="rounded-md border border-gray-200 bg-white px-3 py-2.5 text-center dark:border-gray-700 dark:bg-gray-900"
      >
        <p class="font-medium text-gray-700 dark:text-gray-300">Web App</p>
        <p class="mt-0.5 text-xs text-gray-400 dark:text-gray-500">Browser</p>
      </div>
      <div
        class="rounded-md border border-gray-200 bg-white px-3 py-2.5 text-center dark:border-gray-700 dark:bg-gray-900"
      >
        <p class="font-medium text-gray-700 dark:text-gray-300">Shared Links</p>
        <p class="mt-0.5 text-xs text-gray-400 dark:text-gray-500">Vet · groomer · viewer</p>
      </div>
    </div>
  </div>

  {/* Arrow */}
  <div class="flex justify-center text-gray-300 dark:text-gray-600">
    <div class="flex flex-col items-center">
      <div class="h-3 w-px bg-current"></div>
      <span>&#9660;</span>
    </div>
  </div>

  {/* Security boundary: Edge */}
  <div
    class="rounded-lg border-2 border-dashed border-sky-300 bg-sky-50/50 p-3 dark:border-sky-800 dark:bg-sky-950/20"
  >
    <p class="mb-2 text-xs tracking-widest text-sky-500 uppercase dark:text-sky-400">Sign-in</p>
    <div
      class="rounded-md border border-sky-200 bg-white px-3 py-2 text-center dark:border-sky-800 dark:bg-gray-900"
    >
      <p class="font-medium text-gray-700 dark:text-gray-300">Kinde</p>
      <p class="mt-0.5 text-xs text-gray-400 dark:text-gray-500">
        OpenID Connect · PKCE · MFA available
      </p>
    </div>
  </div>

  {/* Arrow */}
  <div class="flex justify-center text-gray-300 dark:text-gray-600">
    <div class="flex flex-col items-center">
      <div class="h-3 w-px bg-current"></div>
      <span>&#9660;</span>
    </div>
  </div>

  {/* Platform boundary */}
  <div
    class="rounded-lg border-2 border-dashed border-sky-300 bg-sky-50/50 p-3 dark:border-sky-800 dark:bg-sky-950/20"
  >
    <p class="mb-3 text-xs tracking-widest text-sky-500 uppercase dark:text-sky-400">
      VetFo Platform — Railway
    </p>

    {/* API + Scanner Pipeline */}
    <div class="grid gap-2 sm:grid-cols-3">
      <div
        class="rounded-md border border-gray-200 bg-white px-3 py-2.5 text-center dark:border-gray-700 dark:bg-gray-900"
      >
        <p class="font-medium text-gray-700 dark:text-gray-300">VetFo Server</p>
        <p class="mt-0.5 text-xs text-gray-400 dark:text-gray-500">
          Authorization checks · Rate limits
        </p>
      </div>
      <div
        class="rounded-md border border-gray-200 bg-white px-3 py-2.5 text-center dark:border-gray-700 dark:bg-gray-900"
      >
        <p class="font-medium text-gray-700 dark:text-gray-300">Background Jobs</p>
        <p class="mt-0.5 text-xs text-gray-400 dark:text-gray-500">Reminders · Records requests</p>
      </div>
      <div
        class="rounded-md border border-emerald-300 bg-emerald-50 px-3 py-2.5 text-center dark:border-emerald-800 dark:bg-emerald-950/30"
      >
        <p class="font-medium text-emerald-700 dark:text-emerald-300">AI Features</p>
        <p class="mt-0.5 text-xs text-emerald-500 dark:text-emerald-400">Google Gemini</p>
        <p class="text-xs text-emerald-500 dark:text-emerald-400">Opt-in AI data sharing</p>
      </div>
    </div>

    {/* Arrow to storage */}
    <div class="flex justify-center py-2 text-gray-300 dark:text-gray-600">
      <div class="flex flex-col items-center">
        <div class="h-2 w-px bg-current"></div>
        <span class="text-xs">stored data &#9660;</span>
      </div>
    </div>

    {/* Storage layer */}
    <div class="grid gap-2 sm:grid-cols-2">
      <div
        class="rounded-md border border-gray-200 bg-white px-3 py-2.5 dark:border-gray-700 dark:bg-gray-900"
      >
        <p class="font-medium text-gray-700 dark:text-gray-300">PostgreSQL</p>
        <p class="mt-0.5 text-xs text-gray-400 dark:text-gray-500">AES-256 at rest</p>
        <p class="text-xs text-gray-400 dark:text-gray-500">AES-256-GCM encrypted credentials</p>
        <p class="text-xs text-gray-400 dark:text-gray-500">Per-pet access checks</p>
      </div>
      <div
        class="rounded-md border border-gray-200 bg-white px-3 py-2.5 dark:border-gray-700 dark:bg-gray-900"
      >
        <p class="font-medium text-gray-700 dark:text-gray-300">Redis</p>
        <p class="mt-0.5 text-xs text-gray-400 dark:text-gray-500">Sessions · Live notifications</p>
        <p class="text-xs text-gray-400 dark:text-gray-500">Cache only</p>
      </div>
    </div>
  </div>

  {/* Arrows to external */}
  <div class="flex justify-around text-gray-300 dark:text-gray-600">
    <div class="flex flex-col items-center">
      <div class="h-3 w-px bg-current"></div>
      <span>&#9660;</span>
    </div>
    <div class="flex flex-col items-center">
      <div class="h-3 w-px bg-current"></div>
      <span>&#9660;</span>
    </div>
  </div>

  {/* External flows */}
  <div class="grid gap-2 sm:grid-cols-2">
    <div>
      <p class="mb-2 text-xs tracking-widest text-gray-400 uppercase dark:text-gray-500">
        Subprocessors
      </p>
      <div class="space-y-1.5">
        <div
          class="flex items-center justify-between rounded-md border border-gray-200 bg-white px-3 py-2 dark:border-gray-700 dark:bg-gray-900"
        >
          <span class="text-gray-700 dark:text-gray-300">Stripe</span>
          <span class="text-xs text-gray-400 dark:text-gray-500">Billing</span>
        </div>
        <div
          class="flex items-center justify-between rounded-md border border-gray-200 bg-white px-3 py-2 dark:border-gray-700 dark:bg-gray-900"
        >
          <span class="text-gray-700 dark:text-gray-300">Resend</span>
          <span class="text-xs text-gray-400 dark:text-gray-500">Email</span>
        </div>
        <div
          class="flex items-center justify-between rounded-md border border-gray-200 bg-white px-3 py-2 dark:border-gray-700 dark:bg-gray-900"
        >
          <span class="text-gray-700 dark:text-gray-300">Twilio</span>
          <span class="text-xs text-gray-400 dark:text-gray-500">SMS · Support calls</span>
        </div>
      </div>
    </div>
    <div>
      <p class="mb-2 text-xs tracking-widest text-gray-400 uppercase dark:text-gray-500">
        Document Storage
      </p>
      <div
        class="rounded-md border border-gray-200 bg-white px-3 py-2.5 dark:border-gray-700 dark:bg-gray-900"
      >
        <p class="font-medium text-gray-700 dark:text-gray-300">Cloudflare R2</p>
        <p class="mt-0.5 text-xs text-gray-400 dark:text-gray-500">Uploaded pet documents</p>
        <p class="text-xs text-gray-400 dark:text-gray-500">Support voicemails</p>
        <p class="text-xs text-gray-400 dark:text-gray-500">Private bucket</p>
      </div>
    </div>
  </div>

  {/* Legend */}
  <div
    class="mt-4 flex flex-wrap gap-x-5 gap-y-1.5 border-t border-gray-100 pt-3 text-xs text-gray-400 dark:border-gray-800 dark:text-gray-500"
  >
    <span class="flex items-center gap-1.5">
      <span
        class="inline-block h-2 w-3 rounded-sm border-2 border-dashed border-sky-300 dark:border-sky-700"
      ></span>
      Security boundary
    </span>
    <span class="flex items-center gap-1.5">
      <span
        class="inline-block h-2 w-3 rounded-sm border border-emerald-300 bg-emerald-50 dark:border-emerald-800 dark:bg-emerald-950/30"
      ></span>
      Isolated component
    </span>
    <span class="flex items-center gap-1.5">
      <span
        class="inline-block h-2 w-3 rounded-sm border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900"
      ></span>
      Component
    </span>
    <span>Connections use HTTPS</span>
  </div>
</div>
